      " 2024 175 2II_F.1.1.2 2II_F.1.1.2   False  0.085   0.034\n",
      "\n",
      "DENV3\n",
      " year  n lin_prev      dom  cambio  media  propio\n",
      " 2002  8 3III_C.1 3III_C.1   False  0.023   0.023\n",
      " 2003 24 3III_C.1 3III_C.1   False  0.027   0.028\n",
      " 2004  8 3III_C.1 3III_C.1   False  0.015   0.011\n",
      " 2005  7 3III_C.1 3III_C.1   False  0.034   0.029\n",
      " 2006  8 3III_C.1 3III_C.1   False  0.026   0.020\n",
      " 2007 13 3III_C.1 3III_C.1   False  0.032   0.026\n",
      " 2010 11 3III_C.1 3III_C.2    True  0.031   0.022\n",
      " 2012 19 3III_C.2 3III_C.2   False  0.041   0.041\n",
      " 2013 43 3III_C.2 3III_C.2   False  0.036   0.036\n",
      " 2014  7 3III_C.2 3III_C.2   False  0.050   0.050\n",
      " 2015 17 3III_C.2 3III_C.2   False  0.039   0.035\n",
      " 2016 10 3III_C.2 3III_C.2   False  0.032   0.029\n",
      " 2023 31 3III_C.2 3III_C.1    True  0.028   0.021\n",
      " 2024 45 3III_C.1 3III_C.1   False  0.018   0.018\n",
      "\n",
      "DENV4\n",
      " year  n lin_prev     dom  cambio  media  propio\n",
      " 2004  5    4II_B 4II_B.1    True  0.067   0.008\n",
      " 2013 14  4II_B.1 4II_B.1   False  0.038   0.042\n",
      "\n",
      "  Guardado: distancia_linaje_previo.png\n"
     ]
    }
   ],
   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(11, 7.5))\n",
    "series_linaje = {}\n",
    "\n",
    "for ax, sero in zip(axes.ravel(), [1, 2, 3, 4]):\n",
    "    C_PREV = SERO_COLORS[sero]\n",
    "    t = series_linaje[sero] = serie_linaje(sero)\n",
    "    if t.empty:\n",
    "        ax.set_axis_off()\n",
    "        continue\n",
    "\n",
    "    # la línea se corta en los vacíos de vigilancia\n",
    "    for _, tr in t.groupby(t.year.diff().gt(2).cumsum()):\n",
    "        ax.fill_between(tr.year, tr.lo, tr.hi, color=C_PREV, alpha=0.18, lw=0)\n",
    "        ax.plot(tr.year, tr.media, \"-\", color=C_PREV, lw=2, zorder=3)\n",
    "        ax.plot(tr.year, tr.propio, \"--\", color=C_SELF, lw=2, zorder=2)\n",
    "\n",
    "    camb = t[t.cambio]\n",
    "    # línea vertical en cada cambio de linaje dominante\n",
    "    for yr in camb.year:\n",
    "        ax.axvline(yr, color=\"#b5b5b5\", ls=\":\", lw=1.2, zorder=1)\n",
    "    ax.scatter(camb.year, camb.media, s=70, facecolor=\"white\",\n",
    "               edgecolor=C_PREV, lw=2, zorder=4)\n",
    "    ax.scatter(t[~t.cambio].year, t[~t.cambio].media, s=28, color=C_PREV, zorder=4)\n",
    "    for k, (_, r) in enumerate(camb.iterrows()):\n",
    "        ax.annotate(r[\"dom\"], (r.year, r.media), textcoords=\"offset points\",\n",
    "                    xytext=(0, 12 if k % 2 == 0 else -18), ha=\"center\",\n",
    "                    fontsize=8, color=C_PREV, annotation_clip=False, zorder=6,\n",
    "                    bbox=dict(boxstyle=\"round,pad=0.15\", fc=\"white\", ec=\"none\", alpha=0.85))\n",
    "\n",
    "    ax.set_title(f\"DENV-{sero}\", fontsize=12, fontweight=\"bold\", loc=\"left\")\n",
    "    ax.set_xlabel(\"Año de muestreo\", fontsize=10)\n",
    "    ax.set_ylabel(\"Distancia epitópica media\", fontsize=10)\n",
    "    ax.grid(axis=\"y\", alpha=0.25, lw=0.6)\n",
    "    ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "    # todos los años en el eje x\n",
    "    ax.set_xticks(range(int(t.year.min()), int(t.year.max()) + 1))\n",
    "    ax.tick_params(axis=\"x\", labelsize=7, labelrotation=90)\n",
    "    ax.margins(x=0.03, y=0.16)\n",
    "\n",
    "h = [tuple(plt.Line2D([], [], color=SERO_COLORS[s], lw=2) for s in (1, 2, 3, 4)),\n",
    "     plt.Line2D([], [], color=C_SELF, lw=2, ls=\"--\"),\n",
    "     (plt.Line2D([], [], color=\"#b5b5b5\", ls=\":\", lw=1.2),\n",
    "      plt.Line2D([], [], marker=\"o\", ls=\"\", mfc=\"white\", mec=\"#444444\", mew=2, ms=9))]\n",
    "fig.legend(handles=h,\n",
    "           labels=[\"Distancia al linaje dominante\",\n",
    "                   \"Distancia de cada cepa a su propio linaje\",\n",
    "                   \"Año en que cambia el linaje dominante\"],\n",
    "           handler_map={tuple: matplotlib.legend_handler.HandlerTuple(ndivide=None, pad=0.4)},\n",
    "           loc=\"lower center\", ncol=3, frameon=False, fontsize=10,\n",
    "           bbox_to_anchor=(0.5, -0.035))\n",
    "\n",
    "fig.suptitle(\"Distancia epitópica media al linaje anteriormente dominante\",\n",
    "             fontsize=13, fontweight=\"bold\", y=1.0)\n",
    "fig.text(0.5, 0.962,\n",
    "         f\"Distancia de Grantham sobre sitios epitópicos (Ec. 3); solo años con ≥{MIN_N} secuencias. \"\n",
    "         \"Banda: IC 95% bootstrap. La línea se corta en los vacíos de vigilancia (>2 años).\",\n",
    "         ha=\"center\", fontsize=9, style=\"italic\")\n",
    "fig.tight_layout(rect=[0, 0, 1, 0.945])\n",
    "fig.savefig(\"../figures/distancia_linaje_previo.png\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "plt.close()\n",
    "\n",
    "for sero, t in series_linaje.items():\n",
    "    print(f\"\\nDENV{sero}\")\n",
    "    print(t[[\"year\", \"n\", \"lin_prev\", \"dom\", \"cambio\", \"media\", \"propio\"]]\n",
    "          .round(3).to_string(index=False))\n",
    "print(\"\\n  Guardado: distancia_linaje_previo.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5111d0aa",
   "metadata": {},
   "source": [
    "## ¿El salto antigénico de un reemplazo supera al que predice su divergencia genética?\n",
    "\n",
    "Un linaje que reemplaza a otro está, por definición, lejos del anterior y cerca de\n",
    "sí mismo, y la coordenada antigénica se proyecta de la misma secuencia del gen E\n",
    "que define el linaje. Observar que la distancia antigénica sube en un reemplazo es\n",
    "por tanto circular. La pregunta no circular es **si sube más de lo que predice la\n",
    "divergencia genética de ese mismo par de secuencias**.\n",
    "\n",
    "Se compara cada par de cepas colombianas del evento contra la mediana de los pares\n",
    "que no son del evento **con la misma divergencia genética**, usando dos predictores:\n",
    "\n",
    "- **No epítopo**, el predictor principal: distancia de Grantham sobre las 325\n",
    "  posiciones del gen E que no son de epítopo, normalizada igual que la antigénica.\n",
    "  Respuesta y predictor no comparten ni un sitio, y no interviene ningún árbol.\n",
    "- **Patrística**, años de divergencia en el árbol MCC del serotipo. Es el predictor\n",
    "  que pide la intuición, pero los pares de un reemplazo se acumulan en el techo del\n",
    "  rango patrístico, donde hay pocos pares con que calibrar; se reporta su cobertura.\n",
    "\n",
    "Los dos grupos de cada evento son las mismas unidades de análisis BDSKY del capítulo\n",
    "de Rₑ, no la etiqueta de linaje de Nextclade, que reutiliza `3III_C.1` para el clado\n",
    "histórico y para el de 2023.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "6e30d44b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "autoprueba: 199 pares, diferencia maxima 0e+00 contra antigenic_distance\n",
      "posiciones: 170 de epitopo, 325 no epitopicas\n"
     ]
    }
   ],
   "source": [
    "# Matrices Colombia x Colombia, vectorizadas.\n",
    "#\n",
    "# antigenic_distance() recorre la secuencia en Python y aqui hacen falta todos\n",
    "# los pares de un serotipo (hasta 109.000) y 2.000 remuestreos, asi que se\n",
    "# reimplementa con una tabla de consulta de Grantham y aritmetica de numpy. La\n",
    "# autoprueba exige coincidencia exacta con antigenic_distance en 200 pares al\n",
    "# azar: si alguna vez divergen, la celda falla en vez de reportar otra cosa.\n",
    "\n",
    "ALFA = \"ACDEFGHIKLMNPQRSTVWY\"\n",
    "W_GRANTHAM = 215          # normalizacion de la Ec. 2\n",
    "\n",
    "DOMINIOS = {\n",
    "    \"EDI\":   [[47, 47], [123, 126], [148, 165], [167, 167],\n",
    "              [170, 177], [180, 180], [279, 279], [293, 293]],\n",
    "    \"EDII\":  [[67, 74], [76, 79], [88, 88], [97, 118],\n",
    "              [215, 215], [219, 219], [233, 233], [237, 237],\n",
    "              [244, 249], [256, 256], [266, 268], [272, 276]],\n",
    "    \"EDIII\": [[282, 282], [298, 311], [314, 370],\n",
    "              [372, 372], [382, 385], [387, 390]],\n",
    "}\n",
    "\n",
    "\n",
    "def _posiciones(rangos):\n",
    "    \"\"\"Rangos 1-based inclusivos de la literatura -> indices 0-based.\"\"\"\n",
    "    return np.array(sorted({k for a, b in rangos for k in range(a - 1, b)}))\n",
    "\n",
    "\n",
    "POS = {d: _posiciones(r) for d, r in DOMINIOS.items()}\n",
    "POS_EPI = np.array(sorted(set().union(*(set(p.tolist()) for p in POS.values()))))\n",
    "POS_NOEPI = np.setdiff1d(np.arange(E_LEN_STD), POS_EPI)\n",
    "\n",
    "\n",
    "def _tabla_grantham():\n",
    "    \"\"\"Consulta 128x128 construida llamando a grantham_distance, no a mano.\"\"\"\n",
    "    T = np.zeros((128, 128))\n",
    "    for a in ALFA:\n",
    "        for b in ALFA:\n",
    "            T[ord(a), ord(b)] = grantham_distance(a, b)\n",
    "    return T\n",
    "\n",
    "\n",
    "T_GRANTHAM = _tabla_grantham()\n",
    "\n",
    "\n",
    "def codifica(seqs):\n",
    "    \"\"\"Secuencias en numeracion comun -> (codigos n x 495, mascara de validas).\"\"\"\n",
    "    s = [_to_std_numbering(x) for x in seqs]\n",
    "    assert {len(x) for x in s} == {E_LEN_STD}, \"longitudes distintas tras numerar\"\n",
    "    raras = set(\"\".join(s)) - set(ALFA) - set(\"-*\")\n",
    "    assert not raras, f\"residuos no contemplados por Grantham: {raras}\"\n",
    "    C = np.frombuffer(\"\".join(s).encode(), dtype=\"S1\").reshape(len(s), E_LEN_STD)\n",
    "    C = C.view(np.uint8)\n",
    "    return C, ~np.isin(C, [ord(\"-\"), ord(\"*\")])\n",
    "\n",
    "\n",
    "def _suma_y_n(C, ok, pos):\n",
    "    \"\"\"(suma de Grantham, columnas validas) de cada par, sobre esas posiciones.\"\"\"\n",
    "    n = C.shape[0]\n",
    "    S = np.zeros((n, n))\n",
    "    N = np.zeros((n, n), dtype=np.int32)\n",
    "    for j in pos:\n",
    "        col = C[:, j]\n",
    "        m = ok[:, j][:, None] & ok[:, j][None, :]\n",
    "        S += np.where(m, T_GRANTHAM[np.ix_(col, col)], 0.0)\n",
    "        N += m\n",
    "    return S, N\n",
    "\n",
    "\n",
    "def _normaliza(S, N):\n",
    "    \"\"\"Ec. 2: (suma de G / (n * 215)) * 20, con los huecos fuera del denominador.\"\"\"\n",
    "    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n",
    "        return np.where(N > 0, S / (N * W_GRANTHAM) * 20.0, np.nan)\n",
    "\n",
    "\n",
    "def matrices_colombia(seqs):\n",
    "    \"\"\"(antigenica p-all-epitope, no epitopica) para todos los pares.\"\"\"\n",
    "    C, ok = codifica(seqs)\n",
    "    epi = np.mean([_normaliza(*_suma_y_n(C, ok, POS[d])) for d in DOMINIOS], axis=0)\n",
    "    return epi, _normaliza(*_suma_y_n(C, ok, POS_NOEPI))\n",
    "\n",
    "\n",
    "# ─────────────────── autoprueba contra antigenic_distance ───────────────────\n",
    "_ids, _seqs = _load_filtered_fasta(AA_SEQS_COL_E.format(2), \"NODE\")\n",
    "_epi, _ = matrices_colombia(_seqs)\n",
    "_rng = np.random.default_rng(0)\n",
    "_p = _rng.choice(len(_ids), (200, 2))\n",
    "_p = _p[_p[:, 0] != _p[:, 1]]\n",
    "_dif = max(abs(antigenic_distance(_seqs[i], _seqs[j], 2) - _epi[i, j]) for i, j in _p)\n",
    "assert _dif == 0.0, f\"la version vectorizada no reproduce antigenic_distance ({_dif})\"\n",
    "print(f\"autoprueba: {len(_p)} pares, diferencia maxima {_dif:.0e} contra \"\n",
    "      f\"antigenic_distance\\nposiciones: {len(POS_EPI)} de epitopo, \"\n",
    "      f\"{len(POS_NOEPI)} no epitopicas\")\n"
   ]
  },
