    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "  Guardados: figures/residuo_antigenico_reemplazos.png · output/residuo_antigenico_eventos.csv · output/residuo_antigenico_calibracion.csv · output/residuo_antigenico_bloques.csv\n"
     ]
    }
   ],
   "source": [
    "# Residuo antigenico de cada reemplazo sobre su divergencia genetica.\n",
    "#\n",
    "# Para cada par de cepas del evento se busca la mediana de la distancia\n",
    "# antigenica de los pares que NO son del evento y caen en su mismo bin de\n",
    "# divergencia (20 bins por cuantiles, minimo 50 pares de referencia por bin).\n",
    "# El residuo es la diferencia. El intervalo se obtiene remuestreando SECUENCIAS\n",
    "# dentro de cada grupo, no pares: los pares comparten cepas y tratarlos como\n",
    "# independientes estrecharia el intervalo artificialmente.\n",
    "\n",
    "import re\n",
    "\n",
    "LIN_MCC_EV = \"../resources/BEAST/lineage/combined/BDSKY_{}_MCC.tree\"\n",
    "PATRISTICA_EV = \"../output/patristic_MCC_DENV{}.csv\"\n",
    "N_BIN, MIN_BIN, N_BOOT = 20, 50, 2000\n",
    "MIN_COBERTURA = 0.80      # por debajo, el contraste no se lee: no hay con que calibrar\n",
    "\n",
    "EVENTOS = [\n",
    "    dict(nombre=\"DENV-2 · 2022\", sero=2, residente=\"DENV2_2III_D2\",\n",
    "         entrante=\"DENV2_2II_F1112\", etiq=\"2III_D.2 → 2II_F.1.1.2\",\n",
    "         papel=\"introduccion de un genotipo nuevo\"),\n",
    "    dict(nombre=\"DENV-3 · ~2010\", sero=3, residente=\"DENV3_3III_C1_hist\",\n",
    "         entrante=\"DENV3_3III_C2\", etiq=\"3III_C.1 hist → 3III_C.2\",\n",
    "         papel=\"relevo entre sublinajes cocirculantes\"),\n",
    "    dict(nombre=\"DENV-3 · 2023\", sero=3, residente=\"DENV3_3III_C2\",\n",
    "         entrante=\"DENV3_3III_C1_2023\", etiq=\"3III_C.2 → 3III_C.1 (2023–24)\",\n",
    "         papel=\"reemergencia tras siete anios sin DENV-3\"),\n",
    "]\n",
    "\n",
    "\n",
    "def puntas_de(tag):\n",
    "    txt = open(LIN_MCC_EV.format(tag), encoding=\"utf-8\").read()\n",
    "    m = re.search(r\"Taxlabels(.*?);\", txt, re.S | re.I)\n",
    "    return [l.strip() for l in m.group(1).split(\"\\n\") if l.strip()]\n",
    "\n",
    "\n",
    "def datos_serotipo(sero):\n",
    "    \"\"\"Ids comunes a FASTA y patristica, con las tres matrices alineadas.\"\"\"\n",
    "    ids, seqs = _load_filtered_fasta(AA_SEQS_COL_E.format(sero), \"NODE\")\n",
    "    P = pd.read_csv(PATRISTICA_EV.format(sero), index_col=0)\n",
    "    com = [i for i in ids if i in P.index]\n",
    "    epi, noepi = matrices_colombia([seqs[ids.index(i)] for i in com])\n",
    "    return com, epi, noepi, P.loc[com, com].to_numpy()\n",
    "\n",
    "\n",
    "def calibracion(y, x, es_evento):\n",
    "    \"\"\"Mediana de y por bin de x usando SOLO los pares que no son del evento.\"\"\"\n",
    "    bordes = np.unique(np.quantile(x, np.linspace(0, 1, N_BIN + 1)))\n",
    "    b = np.clip(np.digitize(x, bordes[1:-1]), 0, len(bordes) - 2)\n",
    "    esperado = np.full(len(x), np.nan)\n",
    "    curva = []\n",
    "    for k in range(len(bordes) - 1):\n",
    "        ref = (b == k) & ~es_evento\n",
    "        ev = (b == k) & es_evento\n",
    "        centro = (bordes[k] + bordes[k + 1]) / 2\n",
    "        hay = ref.sum() >= MIN_BIN\n",
    "        if hay:\n",
    "            esperado[b == k] = np.median(y[ref])\n",
    "        curva.append(dict(\n",
    "            bin=k, x=centro, x_lo=bordes[k], x_hi=bordes[k + 1],\n",
    "            n_ref=int(ref.sum()), n_evento=int(ev.sum()),\n",
    "            mediana_ref=float(np.median(y[ref])) if hay else np.nan,\n",
    "            mediana_evento=float(np.median(y[ev])) if ev.sum() else np.nan))\n",
    "    return esperado, pd.DataFrame(curva)\n",
    "\n",
    "\n",
    "def contraste(ev, com, EPI, NOEPI, PAT):\n",
    "    pos = {s: k for k, s in enumerate(com)}\n",
    "    A = np.array([pos[s] for s in puntas_de(ev[\"residente\"]) if s in pos])\n",
    "    B = np.array([pos[s] for s in puntas_de(ev[\"entrante\"]) if s in pos])\n",
    "    enA = np.zeros(len(com), bool); enA[A] = True\n",
    "    enB = np.zeros(len(com), bool); enB[B] = True\n",
    "\n",
    "    iu = np.triu_indices(len(com), 1)\n",
    "    y = EPI[iu]\n",
    "    m = (enA[iu[0]] & enB[iu[1]]) | (enB[iu[0]] & enA[iu[1]])\n",
    "    ia, ib = iu[0][m], iu[1][m]\n",
    "\n",
    "    filas, curvas = [], []\n",
    "    for pred, x in ((\"no epítopo\", NOEPI[iu]), (\"patrística\", PAT[iu])):\n",
    "        esperado, curva = calibracion(y, x, m)\n",
    "        r = y - esperado\n",
    "        cal = m & np.isfinite(esperado)          # pares con bin calibrable\n",
    "        rc = (y - esperado)[cal]\n",
    "\n",
    "        rng = np.random.default_rng(0)\n",
    "        dentro = np.isfinite(esperado[m])\n",
    "        boot = []\n",
    "        for _ in range(N_BOOT):\n",
    "            sa = set(rng.choice(A, len(A)).tolist())\n",
    "            sb = set(rng.choice(B, len(B)).tolist())\n",
    "            sel = np.fromiter((((u in sa and v in sb) or (u in sb and v in sa))\n",
    "                               for u, v in zip(ia, ib)), bool, len(ia)) & dentro\n",
    "            if sel.any():\n",
    "                boot.append(np.median(r[m][sel]))\n",
    "        lo, hi = np.percentile(boot, [2.5, 97.5])\n",
    "\n",
    "        obs_todos = float(np.median(y[m]))       # sobre TODOS los pares del evento\n",
    "        esp = float(np.median(esperado[cal]))\n",
    "        filas.append(dict(\n",
    "            evento=ev[\"nombre\"], contraste=ev[\"etiq\"], papel=ev[\"papel\"],\n",
    "            predictor=pred, n_residente=len(A), n_entrante=len(B),\n",
    "            n_pares=int(m.sum()), frac_calibrada=float(cal.sum() / m.sum()),\n",
    "            antigenica_mediana=obs_todos,\n",
    "            antigenica_mediana_calibrada=float(np.median(y[cal])),\n",
    "            esperada_mediana=esp, residuo=float(np.median(rc)),\n",
    "            residuo_lo=float(lo), residuo_hi=float(hi),\n",
    "            razon=float(np.median(y[cal]) / esp) if esp else np.nan,\n",
    "            exceso=bool(lo > 0), deficit=bool(hi < 0),\n",
    "            legible=bool(cal.sum() / m.sum() >= MIN_COBERTURA)))\n",
    "        curvas.append(curva.assign(evento=ev[\"nombre\"], predictor=pred))\n",
    "    return pd.DataFrame(filas), pd.concat(curvas, ignore_index=True), (m, iu, y)\n",
    "\n",
    "\n",
    "_cache, _filas, _curvas, _detalle = {}, [], [], {}\n",
    "for _ev in EVENTOS:\n",
    "    if _ev[\"sero\"] not in _cache:\n",
    "        _cache[_ev[\"sero\"]] = datos_serotipo(_ev[\"sero\"])\n",
    "    _f, _c, _d = contraste(_ev, *_cache[_ev[\"sero\"]])\n",
    "    _filas.append(_f); _curvas.append(_c); _detalle[_ev[\"nombre\"]] = _d\n",
    "\n",
    "tabla_residuo = pd.concat(_filas, ignore_index=True)\n",
    "curvas_residuo = pd.concat(_curvas, ignore_index=True)\n",
    "tabla_residuo.round(4).to_csv(\"../output/residuo_antigenico_eventos.csv\", index=False)\n",
    "curvas_residuo.round(4).to_csv(\"../output/residuo_antigenico_calibracion.csv\",\n",
    "                               index=False)\n",
    "\n",
    "_v = tabla_residuo.copy()\n",
    "_v[\"IC 95 %\"] = (\"[\" + _v.residuo_lo.round(3).astype(str) + \"; \"\n",
    "                 + _v.residuo_hi.round(3).astype(str) + \"]\")\n",
    "_v[\"calibrada\"] = (_v.frac_calibrada * 100).round(0).astype(int).astype(str) + \" %\"\n",
    "# Un contraste mal cubierto no se lee en ningun sentido: los pares del evento\n",
    "# caen en bins sin pares de referencia y la mediana observada se calcula sobre\n",
    "# un subconjunto sesgado del propio evento.\n",
    "_v[\"veredicto\"] = np.where(\n",
    "    _v.frac_calibrada < MIN_COBERTURA, \"sin calibrar\",\n",
    "    np.where(_v.exceso, \"exceso\", np.where(_v.deficit, \"déficit\", \"nulo\")))\n",
    "print(_v[[\"evento\", \"predictor\", \"n_pares\", \"calibrada\", \"antigenica_mediana\",\n",
    "          \"esperada_mediana\", \"residuo\", \"IC 95 %\", \"razon\", \"veredicto\"]]\n",
    "      .rename(columns={\"antigenica_mediana\": \"antigénica\",\n",
    "                       \"esperada_mediana\": \"esperada\", \"razon\": \"razón\"})\n",
    "      .round(3).to_string(index=False))\n",
    "print(\"\\nantigénica = mediana sobre TODOS los pares del evento · esperada y residuo,\\n\"\n",
    "      \"sobre los pares cuyo bin tiene al menos \"\n",
    "      f\"{MIN_BIN} pares de referencia.\")\n",
    "\n",
    "# ── ¿es cierto que un linaje entrante esta lejos del anterior y cerca de si\n",
    "# mismo? No por definicion: depende de la profundidad de la separacion y de la\n",
    "# edad del clado. Se mide en vez de suponerse, porque es la premisa que\n",
    "# justificaria el contraste, y en uno de los tres eventos no se cumple.\n",
    "def _dentro(M, I):\n",
    "    return M[np.ix_(I, I)][np.triu_indices(len(I), 1)]\n",
    "\n",
    "\n",
    "_bl = []\n",
    "for _ev in EVENTOS:\n",
    "    _com, _EPI, _NOEPI, _ = _cache[_ev[\"sero\"]]\n",
    "    _pos = {s: k for k, s in enumerate(_com)}\n",
    "    _A = [_pos[s] for s in puntas_de(_ev[\"residente\"]) if s in _pos]\n",
    "    _B = [_pos[s] for s in puntas_de(_ev[\"entrante\"]) if s in _pos]\n",
    "    for _et, _ye, _yn, _n in (\n",
    "            (\"dentro del residente\", _dentro(_EPI, _A), _dentro(_NOEPI, _A), len(_A)),\n",
    "            (\"dentro del entrante\", _dentro(_EPI, _B), _dentro(_NOEPI, _B), len(_B)),\n",
    "            (\"entre los dos\", _EPI[np.ix_(_A, _B)].ravel(),\n",
    "             _NOEPI[np.ix_(_A, _B)].ravel(), np.nan)):\n",
    "        _bl.append(dict(evento=_ev[\"nombre\"], bloque=_et, n_cepas=_n,\n",
    "                        n_pares=len(_ye), antig_mediana=float(np.median(_ye)),\n",
    "                        antig_media=float(_ye.mean()),\n",
    "                        antig_frac_cero=float(np.mean(_ye == 0)),\n",
    "                        noepi_mediana=float(np.median(_yn)),\n",
    "                        noepi_media=float(_yn.mean())))\n",
    "\n",
    "tabla_bloques = pd.DataFrame(_bl)\n",
    "tabla_bloques.round(4).to_csv(\"../output/residuo_antigenico_bloques.csv\", index=False)\n",
    "print(\"\\n═══ Distancia antigénica dentro de cada grupo y entre los dos ═══\")\n",
    "print(tabla_bloques[[\"evento\", \"bloque\", \"n_cepas\", \"antig_mediana\", \"antig_media\",\n",
    "                     \"antig_frac_cero\", \"noepi_mediana\"]]\n",
    "      .round(4).to_string(index=False))\n",
    "print(\"\\nRazón entre-grupos / dentro-del-residente: cuánto separa realmente cada\\n\"\n",
    "      \"reemplazo. No es una constante, y en DENV-3 2023 vale 1.\")\n",
    "for _ev in EVENTOS:\n",
    "    _t = tabla_bloques[tabla_bloques.evento == _ev[\"nombre\"]].set_index(\"bloque\")\n",
    "    _d = _t.loc[\"dentro del residente\", \"antig_mediana\"]\n",
    "    _e = _t.loc[\"entre los dos\", \"antig_mediana\"]\n",
    "    print(f\"  {_ev['nombre']:16s} {_e:.4f} / {_d:.4f} = \"\n",
    "          + (f\"{_e / _d:.2f}\" if _d else \"—\"))\n",
    "\n",
    "# ───────────────────────────── la figura ─────────────────────────────\n",
    "# Dos curvas de medianas por bin en vez de la nube: la separacion vertical ES\n",
    "# el residuo, y la razon se lee de un vistazo. La fila de abajo lo resume con\n",
    "# su intervalo, para poder comparar los seis contrastes entre si.\n",
    "with plt.rc_context({\"font.family\": \"sans-serif\"}):\n",
    "    fig = plt.figure(figsize=(11, 3.0 * len(EVENTOS) + 2.6))\n",
    "    gs = fig.add_gridspec(len(EVENTOS) + 1, 2, hspace=0.55, wspace=0.26,\n",
    "                          height_ratios=[1] * len(EVENTOS) + [0.95])\n",
    "\n",
    "    for fila, ev in enumerate(EVENTOS):\n",
    "        col = SERO_COLORS[ev[\"sero\"]]\n",
    "        for c, pred in enumerate((\"no epítopo\", \"patrística\")):\n",
    "            ax = fig.add_subplot(gs[fila, c])\n",
    "            cur = curvas_residuo[(curvas_residuo.evento == ev[\"nombre\"])\n",
    "                                 & (curvas_residuo.predictor == pred)].sort_values(\"x\")\n",
    "            r = tabla_residuo[(tabla_residuo.evento == ev[\"nombre\"])\n",
    "                              & (tabla_residuo.predictor == pred)].iloc[0]\n",
    "            # Escalones con los bordes reales de cada bin. Los bins son por\n",
    "            # cuantiles y sus anchos difieren mucho: unir los centros con una\n",
    "            # recta sugeriria una tendencia donde solo hay un bin ancho.\n",
    "            def escalon(df, columna):\n",
    "                return (df[[\"x_lo\", \"x_hi\"]].to_numpy().ravel(),\n",
    "                        np.repeat(df[columna].to_numpy(), 2))\n",
    "\n",
    "            d = cur[cur.n_evento > 0]\n",
    "            xr, yr = escalon(cur, \"mediana_ref\")\n",
    "            xe, ye = escalon(d, \"mediana_evento\")\n",
    "            base = np.interp(xe, xr, yr, left=np.nan, right=np.nan)\n",
    "            ax.fill_between(xe, base, ye, where=ye >= base, color=col, alpha=0.18,\n",
    "                            lw=0, step=None, label=\"El evento queda por encima\")\n",
    "            ax.fill_between(xe, base, ye, where=ye < base, color=\"#C0392B\",\n",
    "                            alpha=0.16, lw=0, label=\"El evento queda por debajo\")\n",
    "            ax.plot(xr, yr, color=\"#333333\", lw=2, zorder=5,\n",
    "                    label=\"Pares ajenos al evento\")\n",
    "            ax.plot(xe, ye, color=col, lw=2.4, zorder=6, label=\"Pares del evento\")\n",
    "            # el ultimo bin de cuantiles se extiende hasta el maximo y aplastaria\n",
    "            # el resto del eje, asi que se recorta y se deja asomar\n",
    "            ax.set_xlim(cur.x_lo.min(), cur.x_hi.iloc[-2])\n",
    "\n",
    "            etiq = f\"{ev['nombre']} · {pred}  ·  razón {r.razon:.2f}\"\n",
    "            if not r.legible:\n",
    "                etiq = f\"{ev['nombre']} · {pred}  ·  {r.frac_calibrada:.0%} calibrado\"\n",
    "            ax.set_title(etiq, loc=\"left\", fontsize=10, fontweight=\"bold\")\n",
    "            ax.set_xlabel(f\"Distancia {pred}\", fontsize=9)\n",
    "            ax.set_ylabel(\"Distancia antigénica\", fontsize=9)\n",
    "            ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "            ax.grid(alpha=0.15, lw=0.6)\n",
    "            ax.margins(y=0.18)\n",
    "\n",
    "    # ── resumen: residuo con su intervalo, los seis contrastes juntos\n",
    "    axr = fig.add_subplot(gs[len(EVENTOS), :])\n",
    "    orden = tabla_residuo.reset_index(drop=True)\n",
    "    yy = np.arange(len(orden))[::-1]\n",
    "    axr.axvline(0, color=\"#777777\", lw=1.2, ls=\"--\", zorder=1)\n",
    "    for y0, (_, r) in zip(yy, orden.iterrows()):\n",
    "        c = SERO_COLORS[2 if r.evento.startswith(\"DENV-2\") else 3]\n",
    "        gris = not r.legible\n",
    "        axr.plot([r.residuo_lo, r.residuo_hi], [y0, y0],\n",
    "                 color=\"#AAAAAA\" if gris else c, lw=3.2, solid_capstyle=\"round\",\n",
    "                 zorder=3)\n",
    "        axr.plot(r.residuo, y0, \"o\", ms=8, zorder=4,\n",
    "                 mfc=\"white\" if gris else c, mec=\"#AAAAAA\" if gris else c, mew=2)\n",
    "        axr.annotate(\"sin calibrar\" if gris else f\"×{r.razon:.2f}\",\n",
    "                     (1.004, y0), xycoords=(\"axes fraction\", \"data\"), va=\"center\",\n",
    "                     fontsize=8.5, color=\"#666666\", annotation_clip=False)\n",
    "    axr.set_yticks(yy)\n",
    "    axr.set_yticklabels([f\"{r.evento} · {r.predictor}\" for _, r in orden.iterrows()],\n",
    "                        fontsize=9)\n",
    "    axr.set_ylim(-0.7, len(orden) - 0.3)\n",
    "    axr.set_xlabel(\"Residuo: distancia antigénica observada − esperada por su \"\n",
    "                   \"divergencia genética\", fontsize=9.5)\n",
    "    axr.set_title(\"Resumen · a la derecha, la razón observada/esperada\",\n",
    "                  loc=\"left\", fontsize=10, fontweight=\"bold\")\n",
    "    axr.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "    axr.grid(axis=\"x\", alpha=0.15, lw=0.6)\n",
    "\n",
    "    h, l = fig.axes[0].get_legend_handles_labels()\n",
    "    fig.legend(h, l, loc=\"lower center\", ncol=4, frameon=False, fontsize=9.5,\n",
    "               bbox_to_anchor=(0.5, -0.012))\n",
    "    fig.suptitle(\"¿El salto antigénico de un reemplazo supera al que predice su \"\n",
    "                 \"divergencia genética?\", fontsize=12.5, fontweight=\"bold\", y=0.998)\n",
    "    fig.tight_layout(rect=[0, 0.015, 0.97, 0.978])\n",
    "    fig.savefig(\"../figures/residuo_antigenico_reemplazos.png\", dpi=300,\n",
    "                bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "    plt.close(fig)\n",
    "print(\"\\n  Guardados: figures/residuo_antigenico_reemplazos.png · \"\n",
    "      \"output/residuo_antigenico_eventos.csv · \"\n",
    "      \"output/residuo_antigenico_calibracion.csv · \"\n",
    "      \"output/residuo_antigenico_bloques.csv\")\n"
   ]
  },
