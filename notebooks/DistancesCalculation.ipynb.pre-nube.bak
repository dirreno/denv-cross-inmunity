   "source": [
    "import os\n",
    "from typing import List, Optional, Tuple\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from Bio import SeqIO\n",
    "from matplotlib.colors import to_rgb, to_hex\n",
    "from matplotlib.collections import LineCollection\n",
    "from matplotlib.legend_handler import HandlerTuple\n",
    "from matplotlib.lines import Line2D\n",
    "import baltic as bt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "efae1a96-335d-4d6b-aeca-5a453def593b",
   "metadata": {},
   "outputs": [],
   "source": [
    "SERO = range(1, 5)\n",
    "plt.rcParams['font.family'] = 'sans-serif'\n",
    "\n",
    "# Paleta Okabe-Ito: pasa validación de daltonismo (deutan/protan/tritan).\n",
    "SERO_COLORS = {\n",
    "    1: \"#D55E00\",  # DENV1\n",
    "    2: \"#009E73\",  # DENV2\n",
    "    3: \"#56B4E9\",  # DENV3\n",
    "    4: \"#CC79A7\"   # DENV4\n",
    "}\n",
    "\n",
    "TYPE_INTENSITY = {\n",
    "    \"COL\": 1.0,\n",
    "    \"EXP\": 0.2,\n",
    "    \"MAP\": 1.4\n",
    "}\n",
    "\n",
    "COLOR_UNKNOWN = \"#888888\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "798da80f-9594-4f1b-a90a-6fa18005e217",
   "metadata": {},
   "outputs": [],
   "source": [
    "TIME_TREE_MERGE = \"../resources/merged_data/refined/E_DENV{}_tree_time.nwk\"\n",
    "META_MERGE = \"../resources/merged_data/metadata/merged_DENV{}_meta.tsv\"\n",
    "\n",
    "AA_SEQS_COL_E = \"../resources/colombia_data/AA_sequences/E_DENV{}_aa_E.fasta\"\n",
    "AA_SEQS_EXP_E = \"../resources/experimental_data/AA_sequences/E_DENV{}_aa_E.fasta\"\n",
    "AA_SEQS_EXP_E_MAP = \"../resources/experimental_data/AA_sequences/E_DENV{}_aa_E_map.fasta\"\n",
    "\n",
    "DIST_EPITOPE_GRANTHAM = \"../output/distances_epitope_grantham_DENV{sero}.csv\"\n",
    "DIST_EPITOPE_GRANTHAM_VAL = \"../output/validation_distances_epitope_grantham_DENV{sero}.csv\"\n",
    "DIST_ALL_GRANTHAM_VAL = \"../output/validation_distances_all_grantham_DENV{sero}.csv\"\n",
    "DIST_EPITOPE_HAMMING_VAL = \"../output/validation_distances_epitope_hamming_DENV{sero}.csv\"\n",
    "DIST_ALL_HAMMING_VAL = \"../output/validation_distances_all_hamming_DENV{sero}.csv\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "75b48edd-f950-4aa1-b88e-f2808e189fd5",
   "metadata": {},
   "source": [
    "## Cargar mapa antigénico"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "e12fe309-279d-4443-ae18-a765fdf2ae63",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Antígenos: 412\n",
      "Antisueros: 36\n"
     ]
    }
   ],
   "source": [
    "mapa_ag = pd.read_csv(\n",
    "    \"../resources/experimental_data/2d-antigenic-map.txt\",\n",
    "    sep=r\"\\s+\",\n",
    "    header=None,\n",
    "    names=[\"type\", \"strainID\", \"coord1\", \"coord2\"]\n",
    ")\n",
    "\n",
    "# Extraer serotipo: acepta DENV1 y DEN1\n",
    "mapa_ag[\"sero_num\"] = mapa_ag[\"strainID\"].str.extract(\n",
    "    r\"(?:DENV|DEN)(\\d)\",\n",
    "    expand=False\n",
    ")\n",
    "\n",
    "mapa_ag[\"sero\"] = \"DENV\" + mapa_ag[\"sero_num\"]\n",
    "\n",
    "antigenos = mapa_ag[mapa_ag[\"type\"] == \"AG\"].copy()\n",
    "sueros = mapa_ag[mapa_ag[\"type\"] == \"SR\"].copy()\n",
    "\n",
    "print(f\"Antígenos: {len(antigenos)}\")\n",
    "print(f\"Antisueros: {len(sueros)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6bb07906-1fb3-4601-a38c-2886ba0a4500",
   "metadata": {},
   "source": [
    "### Secuencias de referencia que se encuentran en el mapa"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "8d7d9531-8b8d-4ccf-a138-3f5972726647",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total de cepas de referencia válidas en mapa_ag: 448\n",
      "\n",
      "Filtrando secuencias experimentales...\n",
      "  DENV1: Conservadas 105 / 1316 secuencias.\n",
      "          -> Guardado en: ../resources/experimental_data/AA_sequences/E_DENV1_aa_E_map.fasta\n",
      "  DENV2: Conservadas 86 / 871 secuencias.\n",
      "          -> Guardado en: ../resources/experimental_data/AA_sequences/E_DENV2_aa_E_map.fasta\n",
      "  DENV3: Conservadas 102 / 928 secuencias.\n",
      "          -> Guardado en: ../resources/experimental_data/AA_sequences/E_DENV3_aa_E_map.fasta\n",
      "  DENV4: Conservadas 92 / 740 secuencias.\n",
      "          -> Guardado en: ../resources/experimental_data/AA_sequences/E_DENV4_aa_E_map.fasta\n"
     ]
    }
   ],
   "source": [
    "valid_strain_ids = set(mapa_ag['strainID'].astype(str).tolist())\n",
    "print(f\"Total de cepas de referencia válidas en mapa_ag: {len(valid_strain_ids)}\")\n",
    "\n",
    "serotypes = [1, 2, 3, 4]\n",
    "\n",
    "print(\"\\nFiltrando secuencias experimentales...\")\n",
    "for sero in serotypes:\n",
    "    input_fasta = AA_SEQS_EXP_E.format(sero)\n",
    "    output_fasta = AA_SEQS_EXP_E_MAP.format(sero)\n",
    "    \n",
    "    all_records = list(SeqIO.parse(input_fasta, \"fasta\"))\n",
    "    total_seqs = len(all_records)\n",
    "    \n",
    "    filtered_records = [r for r in all_records if r.id in valid_strain_ids]\n",
    "    kept_seqs = len(filtered_records)\n",
    "    \n",
    "    SeqIO.write(filtered_records, output_fasta, \"fasta\")\n",
    "    \n",
    "    print(f\"  DENV{sero}: Conservadas {kept_seqs} / {total_seqs} secuencias.\")\n",
    "    print(f\"          -> Guardado en: {output_fasta}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9a868f31-5d8d-4566-afb7-971dac3f8a32",
   "metadata": {},
   "source": [
    "### Figura: Árboles filogenéticos por serotipo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "e7fa07a9-0223-436e-a91a-b4abd6c88e63",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_serotype_colors(sero):\n",
    "\n",
    "    base = to_rgb(SERO_COLORS[sero])\n",
    "\n",
    "    def shade(color, intensity):\n",
    "        if intensity <= 1:\n",
    "            # Mezcla con blanco\n",
    "            return to_hex(\n",
    "                tuple(\n",
    "                    1 - intensity * (1 - c)\n",
    "                    for c in color\n",
    "                )\n",
    "            )\n",
    "        # Mezcla con negro\n",
    "        return to_hex(\n",
    "            tuple(\n",
    "                c * (2 - intensity)\n",
    "                for c in color\n",
    "            )\n",
    "        )\n",
    "\n",
    "    return {\n",
    "        \"COL\": shade(\n",
    "            base, TYPE_INTENSITY[\"COL\"]\n",
    "        ),\n",
    "        \"EXP\": shade(\n",
    "            base, TYPE_INTENSITY[\"EXP\"]\n",
    "        ),\n",
    "        \"MAP\": shade(\n",
    "            base, TYPE_INTENSITY[\"MAP\"]\n",
    "        )\n",
    "    }\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "2eae2f2e-f805-4e16-bf43-dcf5134c8063",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "DENV 1\n",
      "Secuencias en FASTA del mapa: 105\n",
      "Experimentales en mapa: 105\n",
      "Ejemplos: ['DENV1/THAILAND/2010/00792/10', 'DENV1/THAILAND/2004/01604/04', 'DENV1/THAILAND/1964/16007', 'DENV1/THAILAND/2001/00355/01', 'DENV1/THAILAND/1999/00380/99']\n",
      "\n",
      "DENV 2\n",
      "Secuencias en FASTA del mapa: 86\n",
      "Experimentales en mapa: 86\n",
      "Ejemplos: ['DENV2/THAILAND/2012/00258/12', 'DENV2/THAILAND/2013/00058/13', 'DENV2/THAILAND/2010/01549/10', 'DENV2/THAILAND/2005/01495/05', 'DENV2/THAILAND/2001/03244/01']\n",
      "\n",
      "DENV 3\n",
      "Secuencias en FASTA del mapa: 102\n",
      "Experimentales en mapa: 102\n",
      "Ejemplos: ['DENV3/THAILAND/2014/00739/14', 'DENV3/NICARAGUA/2009/BID-V4753', 'DENV3/THAILAND/2001/05611/01', 'DENV3/THAILAND/2002/00536/02', 'DENV3/THAILAND/1997/03080/97']\n",
      "\n",
      "DENV 4\n",
      "Secuencias en FASTA del mapa: 92\n",
      "Experimentales en mapa: 92\n",
      "Ejemplos: ['DENV4/THAILAND/2004/00624/04', 'DENV4/THAILAND/1998/04786/98', 'DENV4/THAILAND/1999/04390/99', 'DENV4/THAILAND/2011/00257/11', 'DENV4/THAILAND/1998/06523/98']\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x1400 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def clean_id(x):\n",
    "    \"\"\"\n",
    "    Limpia un identificador sin dividirlo en tokens.\n",
    "    \"\"\"\n",
    "    return str(x).strip()\n",
    "\n",
    "\n",
    "def get_fasta_ids(fasta_path):\n",
    "    \"\"\"\n",
    "    Obtiene los IDs completos de las secuencias del FASTA.\n",
    "    \"\"\"\n",
    "    return {\n",
    "        clean_id(record.id)\n",
    "        for record in SeqIO.parse(fasta_path, \"fasta\")\n",
    "    }\n",
    "\n",
    "\n",
    "def draw_tree(ax, tree, colour, width, size=30, zorder=20000):\n",
    "    \"\"\"\n",
    "    Dibuja el árbol con matplotlib a partir de k.x / k.y de baltic.\n",
    "    No depende de Tree.plotTree / Tree.plotPoints, que no existen\n",
    "    en todas las versiones de baltic.\n",
    "    \"\"\"\n",
    "    segs, seg_c, seg_w = [], [], []\n",
    "    tip_x, tip_y, tip_c = [], [], []\n",
    "\n",
    "    for k in tree.Objects:\n",
    "\n",
    "        x, y = k.x, k.y\n",
    "        x_parent = getattr(getattr(k, 'parent', None), 'x', None)\n",
    "        if x_parent is None:\n",
    "            x_parent = x\n",
    "\n",
    "        c = colour(k)\n",
    "        w = width(k)\n",
    "\n",
    "        # Rama horizontal (padre -> nodo)\n",
    "        segs.append([(x_parent, y), (x, y)])\n",
    "        seg_c.append(c)\n",
    "        seg_w.append(w)\n",
    "\n",
    "        if k.branchType == 'node':\n",
    "            # Conector vertical entre hijos\n",
    "            ys = [ch.y for ch in k.children]\n",
    "            segs.append([(x, min(ys)), (x, max(ys))])\n",
    "            seg_c.append(c)\n",
    "            seg_w.append(w)\n",
    "        else:\n",
    "            tip_x.append(x)\n",
    "            tip_y.append(y)\n",
    "            tip_c.append(c)\n",
    "\n",
    "    ax.add_collection(\n",
    "        LineCollection(\n",
    "            segs,\n",
    "            colors=seg_c,\n",
    "            linewidths=seg_w,\n",
    "            capstyle='round',\n",
    "            zorder=zorder\n",
    "        )\n",
    "    )\n",
    "\n",
    "    ax.scatter(\n",
    "        tip_x, tip_y,\n",
    "        s=size,\n",
    "        c=tip_c,\n",
    "        zorder=zorder + 2\n",
    "    )\n",
    "\n",
    "    ax.autoscale_view()\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 14))\n",
    "axes = axes.flatten()\n",
    "\n",
    "\n",
    "for idx, s in enumerate(range(4)):\n",
    "\n",
    "    sero = s + 1\n",
    "    ax = axes[idx]\n",
    "\n",
    "    SEROTYPE_COLORS = get_serotype_colors(sero)\n",
    "\n",
    "    COLOR_COL = SEROTYPE_COLORS[\"COL\"]\n",
    "    COLOR_EXP = SEROTYPE_COLORS[\"EXP\"]\n",
    "    COLOR_MAP = SEROTYPE_COLORS[\"MAP\"]\n",
    "\n",
    "    ll = bt.load_newick(TIME_TREE_MERGE.format(sero), treeType=\"time\")\n",
    "\n",
    "    df = pd.read_csv(\n",
    "        META_MERGE.format(sero),\n",
    "        sep='\\t'\n",
    "    )\n",
    "\n",
    "    df['country'] = (\n",
    "        df['country']\n",
    "        .fillna('')\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "    )\n",
    "\n",
    "    map_fasta = AA_SEQS_EXP_E_MAP.format(sero)\n",
    "\n",
    "    map_ids = get_fasta_ids(map_fasta)\n",
    "\n",
    "    print(f\"\\nDENV {sero}\")\n",
    "    print(f\"Secuencias en FASTA del mapa: {len(map_ids)}\")\n",
    "\n",
    "    origin_map = {}\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "\n",
    "        strain = clean_id(row['strain'])\n",
    "\n",
    "        if 'colombia' in row['country']:\n",
    "            origin = 'COL'\n",
    "        else:\n",
    "            origin = 'EXP'\n",
    "\n",
    "        origin_map[strain] = origin\n",
    "\n",
    "    experimental_map_ids = set()\n",
    "\n",
    "    for strain, origin in origin_map.items():\n",
    "\n",
    "        if origin == 'EXP' and strain in map_ids:\n",
    "            experimental_map_ids.add(strain)\n",
    "\n",
    "    print(\n",
    "        f\"Experimentales en mapa: \"\n",
    "        f\"{len(experimental_map_ids)}\"\n",
    "    )\n",
    "\n",
    "    # Mostrar algunas para verificar\n",
    "    print(\n",
    "        \"Ejemplos:\",\n",
    "        list(experimental_map_ids)[:5]\n",
    "    )\n",
    "\n",
    "    leaf_colors = {}\n",
    "\n",
    "    for k in ll.Objects:\n",
    "\n",
    "        if k.branchType != 'leaf':\n",
    "            continue\n",
    "\n",
    "        name = clean_id(k.name)\n",
    "\n",
    "        if origin_map.get(name) == 'COL':\n",
    "\n",
    "            leaf_colors[name] = COLOR_COL\n",
    "\n",
    "        elif origin_map.get(name) == 'EXP':\n",
    "\n",
    "            if name in experimental_map_ids:\n",
    "                leaf_colors[name] = COLOR_MAP\n",
    "            else:\n",
    "                leaf_colors[name] = COLOR_EXP\n",
    "\n",
    "        else:\n",
    "\n",
    "            leaf_colors[name] = COLOR_UNKNOWN\n",
    "\n",
    "    def c_func(k):\n",
    "\n",
    "        if k.branchType == 'leaf':\n",
    "            return leaf_colors.get(\n",
    "                clean_id(k.name),\n",
    "                COLOR_UNKNOWN\n",
    "            )\n",
    "\n",
    "        has_col = False\n",
    "        has_exp = False\n",
    "        has_map = False\n",
    "\n",
    "        for d in k.leaves:\n",
    "\n",
    "            d_name = d.name if hasattr(d, 'name') else d\n",
    "\n",
    "            c = leaf_colors.get(\n",
    "                clean_id(d_name),\n",
    "                COLOR_UNKNOWN\n",
    "            )\n",
    "\n",
    "            if c == COLOR_COL:\n",
    "                has_col = True\n",
    "\n",
    "            elif c == COLOR_EXP:\n",
    "                has_exp = True\n",
    "\n",
    "            elif c == COLOR_MAP:\n",
    "                has_map = True\n",
    "\n",
    "        # Si hay más de un tipo dentro del clado,\n",
    "        # dejamos la rama gris\n",
    "        n_types = sum([\n",
    "            has_col,\n",
    "            has_exp,\n",
    "            has_map\n",
    "        ])\n",
    "\n",
    "        if n_types > 1:\n",
    "            return COLOR_UNKNOWN\n",
    "\n",
    "        if has_col:\n",
    "            return COLOR_COL\n",
    "\n",
    "        if has_map:\n",
    "            return COLOR_MAP\n",
    "\n",
    "        if has_exp:\n",
    "            return COLOR_EXP\n",
    "\n",
    "        return COLOR_UNKNOWN\n",
    "\n",
    "    L = sum(\n",
    "        1\n",
    "        for k in ll.Objects\n",
    "        if k.branchType == 'leaf'\n",
    "    )\n",
    "\n",
    "    b_func = lambda k: (\n",
    "        2 + 10.0 * len(k.leaves) / L\n",
    "        if k.branchType == 'node'\n",
    "        else 2\n",
    "    )\n",
    "\n",
    "    draw_tree(\n",
    "        ax,\n",
    "        ll,\n",
    "        colour=c_func,\n",
    "        width=b_func,\n",
    "        size=30\n",
    "    )\n",
    "\n",
    "    for loc in ['left', 'right', 'top']:\n",
    "        ax.spines[loc].set_visible(False)\n",
    "\n",
    "    ax.grid(\n",
    "        axis='x',\n",
    "        ls='-',\n",
    "        color='grey',\n",
    "        alpha=0.3\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "        axis='y',\n",
    "        size=0\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "        axis='x',\n",
    "        labelsize=16\n",
    "    )\n",
    "\n",
    "    ax.set_xlabel(\n",
    "        'Time / Divergence',\n",
    "        fontsize=16\n",
    "    )\n",
    "\n",
    "    ax.set_yticklabels([])\n",
    "\n",
    "    ax.set_title(\n",
    "        f\"DENV {sero}\",\n",
    "        fontsize=16,\n",
    "        fontweight='bold'\n",
    "    )\n",
    "\n",
    "fig.suptitle(\n",
    "    \"Arboles filogeneticos del DENV por serotipo\",\n",
    "    fontsize=20,\n",
    "    fontweight='bold',\n",
    "    y=0.98\n",
    ")\n",
    "\n",
    "\n",
    "# Leyenda de serotipos\n",
    "sero_legend = [\n",
    "    Line2D(\n",
    "        [0], [0],\n",
    "        marker='o',\n",
    "        color='w',\n",
    "        label=f'DENV {sero}',\n",
    "        markerfacecolor=SERO_COLORS[sero],\n",
    "        markersize=12\n",
    "    )\n",
    "    for sero in range(1, 5)\n",
    "]\n",
    "\n",
    "# Leyenda de tipos de secuencia: cada entrada muestra\n",
    "# el tono de get_serotype_colors para los cuatro serotipos\n",
    "TYPE_LABELS = {\n",
    "    \"COL\": \"Colombia\",\n",
    "    \"EXP\": \"Referencia\",\n",
    "    \"MAP\": \"Referencia en mapa antigénico\"\n",
    "}\n",
    "\n",
    "type_handles = [\n",
    "    tuple(\n",
    "        Line2D(\n",
    "            [0], [0],\n",
    "            marker='o',\n",
    "            color='w',\n",
    "            markerfacecolor=get_serotype_colors(sero)[t],\n",
    "            markersize=12\n",
    "        )\n",
    "        for sero in range(1, 5)\n",
    "    )\n",
    "    for t in TYPE_LABELS\n",
    "]\n",
    "\n",
    "fig.legend(\n",
    "    handles=sero_legend,\n",
    "    loc='lower center',\n",
    "    bbox_to_anchor=(0.5, 0.055),\n",
    "    fontsize=14,\n",
    "    ncol=4,\n",
    "    frameon=False,\n",
    "    title='Serotipo'\n",
    ")\n",
    "\n",
    "fig.legend(\n",
    "    handles=type_handles,\n",
    "    labels=list(TYPE_LABELS.values()),\n",
    "    handler_map={tuple: HandlerTuple(ndivide=None, pad=0.3)},\n",
    "    loc='lower center',\n",
    "    bbox_to_anchor=(0.5, 0.005),\n",
    "    fontsize=14,\n",
    "    ncol=3,\n",
    "    frameon=False,\n",
    "    title='Tipo de secuencia'\n",
    ")\n",
    "\n",
    "plt.tight_layout(rect=[0, 0.13, 1, 1])\n",
    "\n",
    "\n",
    "plt.savefig(\n",
    "    \"../figures/DENV_all_serotypes_col_exp.jpeg\",\n",
    "    dpi=300,\n",
    "    bbox_inches='tight'\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "plt.close()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "39199408-8cd9-4436-bb8d-1aff8bcc2966",
   "metadata": {},
   "source": [
    "## Distancias"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5d5d6c1d-00be-4d59-aab9-1514df79cd38",
   "metadata": {},
   "source": [
    "### Distancia de Hamming"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "cf524823-4d59-4548-ba0f-c05249068e3d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def hamming_distance(s1, s2):\n",
    "    if len(s1) != len(s2):\n",
    "        raise ValueError(\"Strings must be of the same length\")\n",
    "    \n",
    "    return sum(el1 != el2 for el1, el2 in zip(s1, s2))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cd29027c-f485-42bf-a880-b20f9e785783",
   "metadata": {},
   "source": [
    "### Distancia de Grantham"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "07ff5a24-e3ef-4c6d-8f0c-03d8e4c7c992",
   "metadata": {},
   "outputs": [],
   "source": [
    "def grantham_distance(s1, s2):\n",
    "    grantham_matrix = {\n",
    "      'A': {'A':0,'R':112,'N':111,'D':126,'C':195,'Q':91,'E':107,'G':60,'H':86,'I':94,'L':96,'K':106,'M':84,'F':113,'P':27,'S':99,'T':58,'W':148,'Y':112,'V':64},\n",
    "      'R': {'A':112,'R':0,'N':86,'D':96,'C':180,'Q':43,'E':54,'G':125,'H':29,'I':97,'L':102,'K':26,'M':91,'F':97,'P':103,'S':110,'T':71,'W':101,'Y':77,'V':96},\n",
    "      'N': {'A':111,'R':86,'N':0,'D':23,'C':139,'Q':46,'E':42,'G':80,'H':68,'I':149,'L':153,'K':94,'M':142,'F':158,'P':91,'S':46,'T':65,'W':174,'Y':143,'V':133},\n",
    "      'D': {'A':126,'R':96,'N':23,'D':0,'C':154,'Q':61,'E':45,'G':94,'H':81,'I':168,'L':172,'K':101,'M':160,'F':177,'P':108,'S':65,'T':85,'W':181,'Y':160,'V':152},\n",
    "      'C': {'A':195,'R':180,'N':139,'D':154,'C':0,'Q':154,'E':170,'G':159,'H':174,'I':198,'L':198,'K':202,'M':196,'F':205,'P':169,'S':112,'T':149,'W':215,'Y':194,'V':192},\n",
    "      'Q': {'A':91,'R':43,'N':46,'D':61,'C':154,'Q':0,'E':29,'G':87,'H':24,'I':109,'L':113,'K':53,'M':101,'F':116,'P':76,'S':68,'T':42,'W':130,'Y':99,'V':96},\n",
    "      'E': {'A':107,'R':54,'N':42,'D':45,'C':170,'Q':29,'E':0,'G':98,'H':40,'I':134,'L':138,'K':56,'M':126,'F':140,'P':93,'S':80,'T':65,'W':152,'Y':122,'V':121},\n",
    "      'G': {'A':60,'R':125,'N':80,'D':94,'C':159,'Q':87,'E':98,'G':0,'H':98,'I':135,'L':138,'K':127,'M':127,'F':153,'P':42,'S':56,'T':59,'W':184,'Y':147,'V':109},\n",
    "      'H': {'A':86,'R':29,'N':68,'D':81,'C':174,'Q':24,'E':40,'G':98,'H':0,'I':94,'L':99,'K':32,'M':87,'F':100,'P':77,'S':89,'T':47,'W':115,'Y':83,'V':84},\n",
    "      'I': {'A':94,'R':97,'N':149,'D':168,'C':198,'Q':109,'E':134,'G':135,'H':94,'I':0,'L':5,'K':102,'M':10,'F':21,'P':95,'S':142,'T':89,'W':61,'Y':33,'V':29},\n",
    "      'L': {'A':96,'R':102,'N':153,'D':172,'C':198,'Q':113,'E':138,'G':138,'H':99,'I':5,'L':0,'K':107,'M':15,'F':22,'P':98,'S':145,'T':92,'W':61,'Y':36,'V':32},\n",
    "      'K': {'A':106,'R':26,'N':94,'D':101,'C':202,'Q':53,'E':56,'G':127,'H':32,'I':102,'L':107,'K':0,'M':95,'F':102,'P':103,'S':121,'T':78,'W':110,'Y':85,'V':97},\n",
    "      'M': {'A':84,'R':91,'N':142,'D':160,'C':196,'Q':101,'E':126,'G':127,'H':87,'I':10,'L':15,'K':95,'M':0,'F':28,'P':87,'S':135,'T':81,'W':67,'Y':36,'V':21},\n",
    "      'F': {'A':113,'R':97,'N':158,'D':177,'C':205,'Q':116,'E':140,'G':153,'H':100,'I':21,'L':22,'K':102,'M':28,'F':0,'P':114,'S':155,'T':103,'W':40,'Y':22,'V':50},\n",
    "      'P': {'A':27,'R':103,'N':91,'D':108,'C':169,'Q':76,'E':93,'G':42,'H':77,'I':95,'L':98,'K':103,'M':87,'F':114,'P':0,'S':74,'T':38,'W':147,'Y':110,'V':68},\n",
    "      'S': {'A':99,'R':110,'N':46,'D':65,'C':112,'Q':68,'E':80,'G':56,'H':89,'I':142,'L':145,'K':121,'M':135,'F':155,'P':74,'S':0,'T':58,'W':177,'Y':144,'V':124},\n",
    "      'T': {'A':58,'R':71,'N':65,'D':85,'C':149,'Q':42,'E':65,'G':59,'H':47,'I':89,'L':92,'K':78,'M':81,'F':103,'P':38,'S':58,'T':0,'W':128,'Y':92,'V':69},\n",
    "      'W': {'A':148,'R':101,'N':174,'D':181,'C':215,'Q':130,'E':152,'G':184,'H':115,'I':61,'L':61,'K':110,'M':67,'F':40,'P':147,'S':177,'T':128,'W':0,'Y':37,'V':88},\n",
    "      'Y': {'A':112,'R':77,'N':143,'D':160,'C':194,'Q':99,'E':122,'G':147,'H':83,'I':33,'L':36,'K':85,'M':36,'F':22,'P':110,'S':144,'T':92,'W':37,'Y':0,'V':55},\n",
    "      'V': {'A':64,'R':96,'N':133,'D':152,'C':192,'Q':96,'E':121,'G':109,'H':84,'I':29,'L':32,'K':97,'M':21,'F':50,'P':68,'S':124,'T':69,'W':88,'Y':55,'V':0}\n",
    "   }\n",
    "    \n",
    "    if len(s1) != len(s2):\n",
    "        raise ValueError(\"Sequences must be of the same length\")\n",
    "\n",
    "    distance = 0\n",
    "\n",
    "    for aa1, aa2 in zip(s1, s2):\n",
    "        if aa1 == \"-\" or aa2 == \"-\":\n",
    "            continue\n",
    "        if aa1 == \"*\" or aa2 == \"*\":\n",
    "            continue\n",
    "        if aa1 not in grantham_matrix or aa2 not in grantham_matrix[aa1]:\n",
    "            continue\n",
    "        distance += grantham_matrix[aa1][aa2]\n",
    "    return distance"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4c0f3837-513f-4d63-b0d4-3bdee137c1b3",
   "metadata": {},
   "source": [
    "### Distancia antigénica p-all-epitope"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "50263945-90c5-48a3-bd0a-39c4370e4efd",
   "metadata": {},
   "outputs": [],
   "source": [
    "E_LEN_STD = 495   # longitud del gen E en DENV1, DENV2 y DENV4\n",
    "DENV3_GAP = 157   # indice 0-based donde DENV3 pierde los residuos 158-159\n",
    "\n",
    "\n",
    "def _to_std_numbering(seq):\n",
    "    \"\"\"Lleva una secuencia a la numeracion comun de DENV1/2/4.\n",
    "\n",
    "    DENV3 tiene dos residuos menos por una delecion en las posiciones\n",
    "    158-159, de modo que se insertan dos huecos para que las cuatro\n",
    "    serotipos compartan el mismo sistema de coordenadas. Asi la posicion\n",
    "    k significa lo mismo en cualquier par de secuencias, tambien cuando\n",
    "    se comparan serotipos distintos.\n",
    "    \"\"\"\n",
    "    if len(seq) == E_LEN_STD - 2:\n",
    "        return seq[:DENV3_GAP] + \"--\" + seq[DENV3_GAP:]\n",
    "    return seq\n",
    "\n",
    "\n",
    "def antigenic_distance(s1, s2, sero=None, type='grantham'):\n",
    "    \"\"\"Distancia antigenica p-all-epitope entre dos secuencias del gen E.\n",
    "\n",
    "    El serotipo se deduce de cada secuencia por separado (ver\n",
    "    _to_std_numbering), por lo que el argumento `sero` se mantiene\n",
    "    unicamente por compatibilidad con llamadas previas y no se utiliza.\n",
    "    \"\"\"\n",
    "    s1 = _to_std_numbering(s1)\n",
    "    s2 = _to_std_numbering(s2)\n",
    "\n",
    "    # Posiciones en numeracion 1-based de DENV1/2/4 (convencion de la literatura)\n",
    "    locations_EDI = [\n",
    "        [47, 47], [123, 126], [148, 165], [167, 167],\n",
    "        [170, 177], [180, 180], [279, 279], [293, 293]\n",
    "    ]\n",
    "    locations_EDII = [\n",
    "        [67, 74], [76, 79], [88, 88], [97, 118],\n",
    "        [215, 215], [219, 219], [233, 233], [237, 237],\n",
    "        [244, 249], [256, 256], [266, 268], [272, 276]\n",
    "    ]\n",
    "    locations_EDIII = [\n",
    "        [282, 282], [298, 311], [314, 370],\n",
    "        [372, 372], [382, 385], [387, 390]\n",
    "    ]\n",
    "\n",
    "    def _domain_distance(locations):\n",
    "        total_dist = 0\n",
    "        n_residues = 0\n",
    "        for start, end in locations:\n",
    "            # Conversion de 1-based inclusivo a slicing 0-based: [start-1 : end]\n",
    "            a, b = s1[start - 1:end], s2[start - 1:end]\n",
    "            # Se ignoran las columnas con hueco o stop en cualquiera de las dos,\n",
    "            # tanto en el numerador como en el denominador: los dos huecos de\n",
    "            # DENV3 no cuentan como diferencias ni diluyen la normalizacion.\n",
    "            pairs = [(x, y) for x, y in zip(a, b)\n",
    "                     if x not in \"-*\" and y not in \"-*\"]\n",
    "            if not pairs:\n",
    "                continue\n",
    "            c1 = \"\".join(x for x, _ in pairs)\n",
    "            c2 = \"\".join(y for _, y in pairs)\n",
    "            if type == 'grantham':\n",
    "                total_dist += grantham_distance(c1, c2)\n",
    "            else:\n",
    "                total_dist += hamming_distance(c1, c2)\n",
    "            n_residues += len(pairs)\n",
    "        return total_dist, n_residues\n",
    "\n",
    "    sum_dist_EDI,   n_EDI   = _domain_distance(locations_EDI)\n",
    "    sum_dist_EDII,  n_EDII  = _domain_distance(locations_EDII)\n",
    "    sum_dist_EDIII, n_EDIII = _domain_distance(locations_EDIII)\n",
    "\n",
    "    w = 215 if type == 'grantham' else 1\n",
    "\n",
    "    # Ec. 2: E_i = (sum G_k) / (n_i * 215) * 20, por dominio\n",
    "    E_EDI   = (sum_dist_EDI   / (n_EDI   * w)) * 20\n",
    "    E_EDII  = (sum_dist_EDII  / (n_EDII  * w)) * 20\n",
    "    E_EDIII = (sum_dist_EDIII / (n_EDIII * w)) * 20\n",
    "\n",
    "    # Ec. 3: promedio de los tres dominios\n",
    "    epit_dist = (E_EDI + E_EDII + E_EDIII) / 3\n",
    "    return epit_dist"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ada59104-b890-4b9d-b784-78dc031512c8",
   "metadata": {},
   "source": [
    "### Validar Corte de regiones epitópicas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "55315cb3-02f0-4b8a-84d5-5522d69f8ee7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DENV2 K88: 1-based=K | 0-based=R  OK\n",
      "DENV2 Q233: 1-based=Q | 0-based=K  OK\n",
      "DENV2 H244: 1-based=H | 0-based=A  OK\n",
      "DENV2 V282: 1-based=H | 0-based=L  --\n",
      "DENV2 V309: 1-based=V | 0-based=K  OK\n",
      "DENV2 K310: 1-based=K | 0-based=E  OK\n",
      "DENV2 K361: 1-based=K | 0-based=D  OK\n",
      "DENV2 E383: 1-based=E | 0-based=P  OK\n",
      "DENV2 P384: 1-based=P | 0-based=G  OK\n",
      "DENV1 K47: 1-based=K | 0-based=T  OK\n",
      "DENV1 H149: 1-based=H | 0-based=Q  OK\n",
      "DENV1 V151: 1-based=V | 0-based=G  OK\n",
      "DENV1 F279: 1-based=F | 0-based=A  OK\n",
      "DENV2 K47: 1-based=K | 0-based=T  OK\n",
      "DENV2 H149: 1-based=H | 0-based=A  OK\n",
      "DENV2 V151: 1-based=V | 0-based=G  OK\n",
      "DENV2 F279: 1-based=F | 0-based=T  OK\n",
      "DENV3 K47: 1-based=K | 0-based=T  OK\n",
      "DENV3 H149: 1-based=H | 0-based=Q  OK\n",
      "DENV3 V151: 1-based=V | 0-based=G  OK\n",
      "DENV3 F279: 1-based=F | 0-based=A  OK\n",
      "DENV4 K47: 1-based=K | 0-based=T  OK\n",
      "DENV4 H149: 1-based=H | 0-based=A  OK\n",
      "DENV4 V151: 1-based=V | 0-based=G  OK\n",
      "DENV4 F279: 1-based=F | 0-based=A  OK\n",
      "DENV4 s[385:390] = ALTLH (esperado ALTLH, posiciones 386-390)\n"
     ]
    }
   ],
   "source": [
    "def get(sero):\n",
    "    return str(next(iter(SeqIO.parse(AA_SEQS_EXP_E_MAP.format(sero), \"fasta\"))).seq)\n",
    "\n",
    "def chk(sero, sites):\n",
    "    s = get(sero)\n",
    "    off = lambda p: p - 2 if (sero == 3 and p > 159) else p   # deleción DENV3\n",
    "    for p, aa in sites.items():\n",
    "        q = off(p)\n",
    "        print(f\"DENV{sero} {aa}{p}: 1-based={s[q-1]} | 0-based={s[q]}  \"\n",
    "              f\"{'OK' if s[q-1]==aa else '--'}\")\n",
    "\n",
    "# DENV2 (filas DV2-44, DV2-76, 3H2/2C8, 1A1D-2)\n",
    "chk(2, {88:'K', 233:'Q', 244:'H', 282:'V', 309:'V', 310:'K',\n",
    "        361:'K', 383:'E', 384:'P'})\n",
    "\n",
    "# J8/J9, DENV1-4: K47, H149, V151, F279\n",
    "for sero in [1, 2, 3, 4]:\n",
    "    chk(sero, {47:'K', 149:'H', 151:'V', 279:'F'})\n",
    "\n",
    "# DENV4, 1G6: 387-ALTLH-390 con T388 y H390\n",
    "s4 = get(4)\n",
    "print(\"DENV4 s[385:390] =\", s4[385:390], \"(esperado ALTLH, posiciones 386-390)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fd2dda68-a991-4320-b653-a70f966d6127",
   "metadata": {},
   "source": [
    "## Calculo de matriz de distancias antigénicas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "8c3fdd35-83f9-4418-bd94-41265638cff0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _load_filtered_fasta(path: str, exclude_prefix: str) -> Tuple[List[str], List[str]]:\n",
    "    \"\"\"Lee un FASTA y devuelve (ids, secuencias), excluyendo IDs con cierto prefijo.\"\"\"\n",
    "    records = [\n",
    "        r for r in SeqIO.parse(path, \"fasta\")\n",
    "        if not r.id.startswith(exclude_prefix)\n",
    "    ]\n",
    "    return [r.id for r in records], [str(r.seq) for r in records]\n",
    "\n",
    "\n",
    "def compute_distance_matrices(\n",
    "    fasta_col_template: str,\n",
    "    fasta_exp_template: str,\n",
    "    exclude_prefix: str = \"NODE\",\n",
    "    metric: str = \"grantham\",\n",
    ") -> List[pd.DataFrame]:\n",
    "    \"\"\"Una matriz de distancias (colombianas x experimentales) por serotipo.\"\"\"\n",
    "    serotypes = [1, 2, 3, 4]\n",
    "\n",
    "    # Referencias experimentales unificadas (todos los serotipos)\n",
    "    ids_exp, seqs_exp = [], []\n",
    "    for sero in serotypes:\n",
    "        ids, seqs = _load_filtered_fasta(fasta_exp_template.format(sero), exclude_prefix)\n",
    "        ids_exp.extend(ids)\n",
    "        seqs_exp.extend(seqs)\n",
    "    print(f\"Conjunto unificado de referencias experimentales: {len(seqs_exp)} secuencias\")\n",
    "\n",
    "    matrices = []\n",
    "    for sero in serotypes:\n",
    "        print(f\"Procesando DENV{sero}...\")\n",
    "        ids_col, seqs_col = _load_filtered_fasta(fasta_col_template.format(sero), exclude_prefix)\n",
    "\n",
    "        matrix = np.full((len(seqs_col), len(seqs_exp)), np.nan)\n",
    "        for i, seq_col in enumerate(seqs_col):\n",
    "            for j, seq_exp in enumerate(seqs_exp):\n",
    "                matrix[i, j] = antigenic_distance(seq_col, seq_exp, sero, type=metric)\n",
    "        matrices.append(pd.DataFrame(matrix, index=ids_col, columns=ids_exp))\n",
    "\n",
    "    return matrices\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "e69c698d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _pad_denv3(seq: str) -> str:\n",
    "    \"\"\"DENV3 tiene dos residuos menos: deleción en 158-159 (numeración DENV1/2/4).\n",
    "    Se insertan dos huecos para que los cuatro serotipos compartan numeración.\"\"\"\n",
    "    return seq[:157] + \"--\" + seq[157:]\n",
    "\n",
    "\n",
    "def gene_distance(s1: str, s2: str, type: str = \"grantham\") -> float:\n",
    "    \"\"\"Distancia sobre todo el gen E, sin recortar a los sitios epitópicos.\n",
    "\n",
    "    Se normaliza igual que la Ec. 2 (dividir por n y por el máximo de la métrica,\n",
    "    escalar por 20) para que quede en la misma escala que la distancia epitópica\n",
    "    y sirva como modelo nulo. Las columnas con hueco o stop se ignoran en ambas\n",
    "    métricas, así que los dos huecos de DENV3 no cuentan como diferencias.\n",
    "    \"\"\"\n",
    "    pairs = [(a, b) for a, b in zip(s1, s2)\n",
    "             if a not in \"-*\" and b not in \"-*\"]\n",
    "    if not pairs:\n",
    "        return np.nan\n",
    "\n",
    "    c1 = \"\".join(a for a, _ in pairs)\n",
    "    c2 = \"\".join(b for _, b in pairs)\n",
    "    total = grantham_distance(c1, c2) if type == \"grantham\" else hamming_distance(c1, c2)\n",
    "    w = 215 if type == \"grantham\" else 1\n",
    "    return (total / (len(pairs) * w)) * 20\n",
    "\n",
    "\n",
    "def compute_gene_distance_matrices(\n",
    "    fasta_col_template: str,\n",
    "    fasta_exp_template: str,\n",
    "    exclude_prefix: str = \"NODE\",\n",
    "    metric: str = \"grantham\",\n",
    ") -> List[pd.DataFrame]:\n",
    "    \"\"\"Como compute_distance_matrices, pero sobre todo el gen E.\"\"\"\n",
    "    serotypes = [1, 2, 3, 4]\n",
    "\n",
    "    # Referencias experimentales unificadas (todos los serotipos)\n",
    "    ids_exp, seqs_exp = [], []\n",
    "    for sero in serotypes:\n",
    "        ids, seqs = _load_filtered_fasta(fasta_exp_template.format(sero), exclude_prefix)\n",
    "        ids_exp.extend(ids)\n",
    "        seqs_exp.extend(_pad_denv3(s) if sero == 3 else s for s in seqs)\n",
    "    print(f\"Conjunto unificado de referencias experimentales: {len(seqs_exp)} secuencias\")\n",
    "\n",
    "    matrices = []\n",
    "    for sero in serotypes:\n",
    "        print(f\"Procesando DENV{sero}...\")\n",
    "        ids_col, seqs_col = _load_filtered_fasta(fasta_col_template.format(sero), exclude_prefix)\n",
    "        if sero == 3:\n",
    "            seqs_col = [_pad_denv3(s) for s in seqs_col]\n",
    "\n",
    "        matrix = np.full((len(seqs_col), len(seqs_exp)), np.nan)\n",
    "        for i, seq_col in enumerate(seqs_col):\n",
    "            for j, seq_exp in enumerate(seqs_exp):\n",
    "                matrix[i, j] = gene_distance(seq_col, seq_exp, type=metric)\n",
    "        matrices.append(pd.DataFrame(matrix, index=ids_col, columns=ids_exp))\n",
    "\n",
    "    return matrices\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bbd81755-49e5-4d12-89c1-fc42df12f796",
   "metadata": {},
   "source": [
    "### Matrices de distancia Grantaham epitópico"
   ]
  },
