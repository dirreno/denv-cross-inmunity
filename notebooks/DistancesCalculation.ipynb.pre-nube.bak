  {
   "cell_type": "markdown",
   "id": "cffbf740-f437-4733-8833-c1ca88aa48c2",
   "metadata": {},
   "source": [
    "### Figura: Distancia media al linaje anteriormente dominante (colombia x colombia, epitope Grantham)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "cffd3caf-9cd1-4b0e-9042-69d08eb69d33",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DENV1: matriz intra (304, 304)\n",
      "DENV2: matriz intra (467, 467)\n",
      "DENV3: matriz intra (261, 261)\n",
      "DENV4: matriz intra (48, 48)\n"
     ]
    }
   ],
   "source": [
    "META_MERGED = \"merged_metadata/meta_merged_{sero}.tsv\"\n",
    "MIN_N = 5\n",
    "C_SELF = \"#6B7280\"\n",
    "\n",
    "# ---- datos: metadatos y matriz de distancias colombiana x colombiana por serotipo\n",
    "info, dist = {}, {}\n",
    "for sero in [1, 2, 3, 4]:\n",
    "    ids, seqs = _load_filtered_fasta(AA_SEQS_COL_E.format(sero), \"NODE\")\n",
    "\n",
    "    meta = pd.read_csv(META_MERGED.format(sero=sero), sep=\"\\t\", dtype=str).set_index(\"strain\")\n",
    "    df = meta.loc[ids, [\"date\", \"lineage\"]].copy()\n",
    "    df[\"year\"] = pd.to_numeric(df[\"date\"].str.slice(0, 4), errors=\"coerce\")\n",
    "    info[sero] = df\n",
    "\n",
    "    n = len(ids)\n",
    "    M = np.zeros((n, n))\n",
    "    for i in range(n):\n",
    "        for j in range(i + 1, n):\n",
    "            M[i, j] = M[j, i] = antigenic_distance(seqs[i], seqs[j], sero)\n",
    "    dist[sero] = pd.DataFrame(M, index=ids, columns=ids)\n",
    "    print(f\"DENV{sero}: matriz intra {M.shape}\")\n",
    "\n",
    "\n",
    "def serie_linaje(sero):\n",
    "    \"\"\"Por año: distancia media de las cepas de ese año al linaje que dominaba\n",
    "    el año anterior, y al propio linaje como línea base.\"\"\"\n",
    "    df, D = info[sero], dist[sero]\n",
    "    cuenta = df.groupby(\"year\").size()\n",
    "    anios = sorted(y for y in cuenta.index if cuenta[y] >= MIN_N)\n",
    "    dom = {y: df[df.year == y][\"lineage\"].mode().iloc[0] for y in anios}\n",
    "\n",
    "    filas = []\n",
    "    for k, y in enumerate(anios[1:], start=1):\n",
    "        L = dom[anios[k - 1]]\n",
    "        ref = df[(df.lineage == L) & (df.year < y)].index\n",
    "        cur = df[df.year == y].index\n",
    "        if len(ref) == 0 or len(cur) == 0:\n",
    "            continue\n",
    "        d_prev = D.loc[cur, ref].mean(axis=1).to_numpy()\n",
    "\n",
    "        d_self = []\n",
    "        for c in cur:\n",
    "            own = df[(df.lineage == df.loc[c, \"lineage\"]) & (df.year < y)].index\n",
    "            own = own.drop(c, errors=\"ignore\")\n",
    "            d_self.append(D.loc[c, own].mean() if len(own) else np.nan)\n",
    "        d_self = np.asarray(d_self, dtype=float)\n",
    "\n",
    "        bs = np.random.default_rng(0).choice(d_prev, (2000, len(d_prev))).mean(axis=1)\n",
    "        filas.append(dict(year=int(y), n=len(cur), lin_prev=L, dom=dom[y],\n",
    "                          cambio=dom[y] != L, media=d_prev.mean(),\n",
    "                          lo=np.percentile(bs, 2.5), hi=np.percentile(bs, 97.5),\n",
    "                          propio=np.nanmean(d_self) if np.isfinite(d_self).any() else np.nan))\n",
    "    return pd.DataFrame(filas)"
   ]
  },
  {
